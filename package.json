{
  "name": "realmaya",
  "version": "1.0.0",
  "description": "AI-native headless browser automation library & MCP v1.x server (Chrome CDP & Firefox WebDriver BiDi) with Token-Compressed Semantic Distiller, Self-Healing Locators, Speculative Branching, and Prompt-Injection Firewall.",
  "author": "Roedy Rustam",
  "license": "MIT",
  "homepage": "https://github.com/roedyrustam/realmaya#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roedyrustam/realmaya.git"
  },
  "bugs": {
    "url": "https://github.com/roedyrustam/realmaya/issues"
  },
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./mcp": {
      "types": "./dist/src/mcp/server.d.ts",
      "import": "./dist/src/mcp/server.js"
    }
  },
  "bin": {
    "realmaya": "./dist/bin/realmaya.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src tests bin",
    "format": "biome check --write src tests bin",
    "prepublishOnly": "npm run typecheck && npm run build && npm test",
    "mcp": "node dist/bin/realmaya.js mcp"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "ai-agents",
    "browser-automation",
    "cdp",
    "chrome-devtools-protocol",
    "headless-browser",
    "headless-chrome",
    "headless-firefox",
    "llm-agents",
    "mcp",
    "mcp-sampling",
    "mcp-server",
    "model-context-protocol",
    "playwright-alternative",
    "prompt-injection-firewall",
    "puppeteer-alternative",
    "self-healing-locators",
    "semantic-dom",
    "typescript",
    "web-scraping",
    "webdriver-bidi"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.12.1",
    "zod": "3.24.2"
  },
  "overrides": {
    "zod-to-json-schema": "3.24.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.15.0",
    "typescript": "^5.8.2",
    "vitest": "^3.1.1"
  }
}
